{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PropertySchema",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "type": { "enum": ["house", "apartment", "bodega", "construction"] },
    "location": {
      "type": "object",
      "properties": {
        "city": { "type": "string" },
        "comuna": { "type": "string" },
        "estrato": { "type": "integer" },
        "geohash": { "type": "string" }
      },
      "required": ["city", "comuna", "estrato"]
    },
    "norms": { "type": "object" },
    "config": {
      "type": "object",
      "properties": {
        "wallThickness": { "type": "number" },
        "scale": { "type": "number" },
        "plot": {
          "type": "object",
          "properties": {
            "width": { "type": "number" },
            "height": { "type": "number" },
            "margin": { "type": "number" }
          },
          "required": ["width", "height"]
        },
        "colors": { "type": "object" }
      },
      "required": ["wallThickness", "scale", "plot"]
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "subtitle": { "type": "string" },
          "ref": { "type": "string" },
          "height_m": { "type": "number" },
          "zones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "subtitle": { "type": "string" },
                "type": { "type": "string" },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "width": { "type": "number" },
                "height": { "type": "number" },
                "color": { "type": "string" }
              },
              "required": ["id", "name", "type", "x", "y", "width", "height"]
            }
          },
          "walls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "x1": { "type": "number" },
                "y1": { "type": "number" },
                "x2": { "type": "number" },
                "y2": { "type": "number" },
                "note": { "type": "string" }
              },
              "required": ["x1", "y1", "x2", "y2"]
            }
          },
          "stairs": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "totalSteps": { "type": "integer" },
              "riser_mm": { "type": "number" },
              "tread_mm": { "type": "number" },
              "totalRise_m": { "type": "number" },
              "components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "width": { "type": "number" },
                    "height": { "type": "number" },
                    "steps": { "type": "integer" },
                    "orientation": { "type": "string" },
                    "arrowDir": { "type": "string" },
                    "label": { "type": "string" }
                  },
                  "required": ["id", "x", "y", "width", "height"]
                }
              }
            },
            "required": ["type", "components"]
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "width": { "type": "number" },
                "height": { "type": "number" },
                "rotation": { "type": "number" },
                "note": { "type": "string" }
              },
              "required": ["type", "x", "y"]
            }
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                },
                "to": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                },
                "label": { "type": "string" },
                "side": { "type": "string" },
                "note": { "type": "string" }
              },
              "required": ["from", "to", "label"]
            }
          }
        },
        "required": ["id", "name"]
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "floorId": { "type": "string" },
          "zoneId": { "type": "string" },
          "name": { "type": "string" },
          "area_m2": { "type": "number" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "roomId": { "type": "string" },
                "name": { "type": "string" },
                "category": { "type": "string" },
                "value": { "type": "number" },
                "warrantyUntil": { "type": "string" },
                "photo": { "type": "string" },
                "qr": { "type": "string" }
              },
              "required": ["id", "name", "category"]
            }
          }
        },
        "required": ["id", "floorId", "name"]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "roomId": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "value": { "type": "number" },
          "warrantyUntil": { "type": "string" },
          "photo": { "type": "string" },
          "qr": { "type": "string" }
        },
        "required": ["id", "name", "category"]
      }
    },
    "taxes": {
      "type": "object",
      "properties": {
        "predial": {
          "type": "object",
          "properties": {
            "jurisdiction": { "type": "string" },
            "avaluo": { "type": "number" },
            "rate_pct": { "type": "number" },
            "installments": { "type": "integer" },
            "dueDates": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["jurisdiction", "avaluo", "rate_pct", "installments", "dueDates"]
        }
      },
      "required": ["predial"]
    },
    "leases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "tenantName": { "type": "string" },
          "rentAmount": { "type": "number" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" }
        },
        "required": ["id"]
      }
    },
    "maintenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "itemId": { "type": "string" },
          "type": { "type": "string" },
          "interval_days": { "type": "integer" },
          "lastDone": { "type": "string" },
          "nextDue": { "type": "string" }
        },
        "required": ["id", "type", "interval_days"]
      }
    },
    "utilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["water", "energy", "gas", "internet"] },
          "provider": { "type": "string" },
          "account": { "type": "string" },
          "dueDay": { "type": "integer" },
          "budget": { "type": "number" }
        },
        "required": ["id", "type", "provider", "account", "dueDay", "budget"]
      }
    }
  },
  "required": ["id", "name", "type", "location", "floors", "rooms", "items"]
}
